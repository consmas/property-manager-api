# Rails
RAILS_ENV=production
RAILS_MASTER_KEY=replace-with-production-master-key
SECRET_KEY_BASE=replace-with-production-secret-key-base
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
ACTIVE_JOB_QUEUE_ADAPTER=sidekiq

# Public app port mapping target (host -> container 3000)
APP_HOST_PORT=3011

# App domain
APP_HOST=propertyapi.rohodev.com

# Database (isolated container in this compose stack)
POSTGRES_USER=property_manager
POSTGRES_PASSWORD=replace-with-strong-production-password
POSTGRES_DB=property_manager_production
DATABASE_URL=postgres://property_manager:replace-with-strong-production-password@db:5432/property_manager_production

# Redis (isolated container in this compose stack)
REDIS_URL=redis://redis:6379/0

# CORS / API
CORS_ALLOWED_ORIGINS=https://propertyapi.rohodev.com,https://elshadai.rohodev.com
JWT_SECRET_KEY=replace-with-long-random-jwt-secret

# Optional integrations
ONLINE_PAYMENTS_MOCK=false
HUBTEL_INITIATE_URL=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_CALLBACK_URL=https://propertyapi.rohodev.com/api/v1/payment_webhooks/hubtel
ZEEPAY_INITIATE_URL=
ZEEPAY_API_KEY=
ZEEPAY_CALLBACK_URL=https://propertyapi.rohodev.com/api/v1/payment_webhooks/zeepay
